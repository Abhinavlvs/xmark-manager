{
  "manifest_version": 3,
  "name": "xmark-manager",
  "version": "0.1.0",
  "description": "Save X posts into folders you control.",
  "icons": {
    "16": "icons/icon-dark.svg",
    "32": "icons/icon-dark.svg",
    "48": "icons/icon-dark.svg",
    "96": "icons/icon-dark.svg",
    "128": "icons/icon-dark.svg"
  },
  "action": {
    "default_title": "xmark-manager",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-dark.svg",
    "theme_icons": [
      {
        "light": "icons/icon-light.svg",
        "dark": "icons/icon-dark.svg",
        "size": 32
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{6c820dd8-f422-43e5-bb44-e392b7fac38a}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://x.com/*", "*://twitter.com/*"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": [
        "content/messages.js",
        "content/selectors.js",
        "content/post-extractor.js",
        "content/dom-util.js",
        "content/styles.js",
        "content/save-button.js",
        "content/panel-folder.js",
        "content/panel-form.js",
        "content/placement.js",
        "content/panel-host.js",
        "content/panel.js",
        "content/injector.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
